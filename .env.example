# Konfigurasi SATUSEHAT.
# Salin file ini menjadi `.env.local`, lalu isi nilainya.
# `.env.local` tidak boleh di-commit.

# Environment: sandbox | production
VITE_SATUSEHAT_ENV=sandbox

# Endpoint publik (aman diekspos ke browser)
VITE_SATUSEHAT_AUTH_URL=https://api-satusehat-stg.dto.kemkes.go.id/oauth2/v1
VITE_SATUSEHAT_BASE_URL=https://api-satusehat-stg.dto.kemkes.go.id/fhir-r4/v1
VITE_SATUSEHAT_CONSENT_URL=https://api-satusehat-stg.dto.kemkes.go.id/consent/v1
VITE_SATUSEHAT_BASE_URL_KPTL=https://api-satusehat-stg.dto.kemkes.go.id/kptl-api-v1

# Identitas aplikasi dan organisasi
VITE_SATUSEHAT_CLIENT_ID=
VITE_SATUSEHAT_ORG_ID=

# Location default untuk registrasi Encounter (UUID Location SATUSEHAT)
VITE_SATUSEHAT_LOCATION_ID=

# Token akses (biasanya diisi backend / hasil pertukaran token)
VITE_SATUSEHAT_TOKEN=

# RAHASIA. Jangan pernah memberi prefix VITE_ agar tidak ikut ke bundle browser,
# dan jangan di-commit. Hanya dipakai backend saat menukar token.
SATUSEHAT_CLIENT_SECRET=
